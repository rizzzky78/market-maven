// Prisma schema for Maven's persistent PostgreSQL store.
//
// Works with any PostgreSQL-compatible database (self-hosted Postgres, Neon,
// Supabase, RDS, ...) through the `@prisma/adapter-pg` driver adapter; the
// connection string comes from `DATABASE_URL` (see prisma.config.ts).
//
// Table and column names map onto the tables the app already used before
// Prisma, so existing databases are baselined instead of recreated
// (see README "Database setup"). Chats moved here from Redis; Redis now only
// holds rate limiting and short-lived session state.

// The client is generated inside the project (src/generated/prisma, imported
// as "@/generated/prisma/client") instead of node_modules, so it is bundled and
// type-checked with the app. It is gitignored: `npm install` (postinstall) and
// `npm run db:generate` rebuild it.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth core schema: user, session, account,
// verification). Field names follow Better Auth's defaults so the Prisma
// adapter needs no field mapping; tables and columns use snake_case.
// ---------------------------------------------------------------------------

/// A signed-in person. Created by Better Auth on first OAuth sign-in. The
/// app keys its own records (chats, stores, shares) by `email`.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]
  accounts Account[]

  @@map("users")
}

/// A Better Auth login session; `token` is the value stored in the session
/// cookie. Removed with its user.
model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

/// A provider identity linked to a user (`providerId`: "google" | "github"),
/// holding the OAuth tokens. `password` is only used by email/password auth.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

/// Short-lived verification values (OAuth state, email verification tokens).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "idx_verifications_identifier")
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// App data
// ---------------------------------------------------------------------------

/// A conversation owned by a user (keyed by the user's email). Holds the persisted AI
/// state of the chat; the tool, object and markdown records produced while
/// chatting belong to it and are removed with it. `title` is generated after
/// the first completed turn, so it is empty until then.
model Chat {
  id        String   @id
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages  ChatMessage[]
  toolData  ToolDataStore[]
  objects   ObjectStore[]
  markdowns MarkdownStore[]

  @@index([userId, updatedAt(sort: Desc)], map: "idx_chats_user_id_updated_at")
  @@map("chats")
}

/// Role of a persisted chat message, mirroring the AI state message roles.
enum MessageRole {
  user
  assistant
  system
  tool

  @@map("message_role")
}

/// One message of a chat's AI state, ordered by `position`. `content` keeps
/// the app's persisted message format (a string, or text / tool-call /
/// tool-result parts) as JSON; `messageId` is the id used by the UI.
model ChatMessage {
  chatId    String      @map("chat_id")
  position  Int
  messageId String      @map("message_id")
  role      MessageRole
  content   Json

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, position])
  @@map("chat_messages")
}

/// Cache of Firecrawl scrape results keyed by the search query, so repeated
/// product searches and detail lookups skip the external scrape.
/// `response` holds the scrape result or its error response as JSON.
model ScrapeCache {
  key       String   @id @db.Uuid
  query     String
  response  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([query], map: "idx_scrape_cache_query")
  @@map("scrape_cache")
}

/// Raw markdown scraped during a tool call, stored per chat and owner so a
/// tool result can be re-rendered or re-extracted later. Belongs to a Chat.
/// `type`: "product-search" | "product-details".
model MarkdownStore {
  key       String   @id
  chatId    String   @map("chat_id")
  owner     String
  type      String
  markdown  String
  timestamp DateTime @default(now()) @db.Timestamptz(6)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId], map: "idx_markdown_store_chat_id")
  @@index([owner], map: "idx_markdown_store_owner")
  @@map("markdown_store")
}

/// Structured objects extracted by the agent tools (search results, product
/// details, comparisons). Later tool calls read them by key, e.g. a product
/// comparison loads the details objects it compares. Belongs to a Chat.
/// `type`: "searchProduct" | "getProductDetails" | "productsComparison".
model ObjectStore {
  key       String   @id
  chatId    String   @map("chat_id")
  owner     String
  type      String
  object    Json
  timestamp DateTime @default(now()) @db.Timestamptz(6)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId], map: "idx_object_store_chat_id")
  @@index([owner], map: "idx_object_store_owner")
  @@map("object_store")
}

/// One record per completed agent tool call: tool name, input arguments,
/// result data and success flag. Shared pages and the tool-data API restore
/// tool output from here. Belongs to a Chat.
model ToolDataStore {
  key         String   @id
  chatId      String   @map("chat_id")
  owner       String
  toolSuccess Boolean  @map("tool_success")
  toolName    String   @map("tool_name")
  toolArgs    Json     @map("tool_args")
  toolData    Json     @map("tool_data")
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId], map: "idx_tool_data_store_chat_id")
  @@index([owner], map: "idx_tool_data_store_owner")
  @@map("tool_data_store")
}

/// Public share links for a chat or a single tool result, with access
/// analytics. `referenceId` is the token used in the public /share URL;
/// `componentId` points at a chat id or a ToolDataStore key.
/// `componentType`: "product-search" | "product-details" |
/// "products-comparison" | "public-chat".
model Share {
  id             String   @id
  userId         String?  @map("user_id")
  userEmail      String   @map("user_email")
  referenceId    String   @unique @map("reference_id")
  componentId    String   @map("component_id")
  componentType  String   @map("component_type")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastAccessedAt DateTime @default(now()) @map("last_accessed_at") @db.Timestamptz(6)
  accessCount    Int      @default(0) @map("access_count")

  @@index([referenceId], map: "idx_shares_reference_id")
  @@index([userId], map: "idx_shares_user_id")
  @@index([componentType], map: "idx_shares_component_type")
  @@map("shares")
}

/// App feedback submitted from the rate-app page and listed on the public
/// reviews page. `rating` is 1-5.
model Rating {
  id        Int      @id @default(autoincrement())
  username  String
  email     String
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ratings")
}
