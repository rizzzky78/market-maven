# Market Maven environment configuration
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# Legend
#   [REQUIRED]  the app fails at startup or on its core flow without it
#   [FEATURE]   required for a specific feature; that feature errors without it
#   [OPTIONAL]  has a safe default or the feature degrades gracefully
#
# Never commit the real `.env`. Generate secrets with: openssl rand -base64 32


# App

# [REQUIRED] Public base URL of the app, without a trailing slash. Used for
# metadata, share links and as the auth base URL fallback. It is inlined into
# the client bundle at build time, so rebuild after changing it (the Docker
# build reads it as a build arg).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [OPTIONAL] Winston log level: error | warn | info | http | verbose | debug | silly
# Default: info
LOG_LEVEL="info"


# Database (PostgreSQL)

# [REQUIRED] Any PostgreSQL-compatible connection string (self-hosted, Neon,
# Supabase, RDS, ...). Used by the Prisma client and `prisma migrate`.
# Legacy fallback: NEON_DATABASE_URL is still read when this is unset.
DATABASE_URL="postgresql://user:password@localhost:5432/maven"


# Authentication (Better Auth)

# [REQUIRED] Secret used to sign session cookies and tokens. Long random string.
# Legacy fallback: NEXTAUTH_SECRET.
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"

# [OPTIONAL] Base URL Better Auth uses for OAuth callbacks.
# Falls back to NEXTAUTH_URL, then NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL="http://localhost:3000"

# [REQUIRED] Google OAuth client. Create one at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# [REQUIRED] GitHub OAuth app. Create one at https://github.com/settings/developers
# Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"


# AI models

# [REQUIRED] Google Generative AI (Gemini) key for Maven's built-in models, used
# for every request that is not routed to a user's own provider connection.
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"

# [OPTIONAL] Gemini model overrides for the built-in models.
# Defaults: gemini-2.5-flash (reasoning) and gemini-2.5-flash-lite (light).
# MAVEN_REASONING_MODEL="gemini-2.5-flash"
# MAVEN_LIGHT_MODEL="gemini-2.5-flash-lite"

# [FEATURE] Encrypts the API keys users save in AI settings (/settings) with
# AES-256-GCM. At least 16 characters. Changing it makes saved keys unreadable
# and users must enter them again.
MAVEN_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# [OPTIONAL] Custom provider base URLs must be public HTTPS by default. Set to
# "true" to also allow private or local http(s) endpoints such as a self-hosted
# Ollama. Only enable on deployments where you trust every user.
# MAVEN_ALLOW_PRIVATE_BASE_URL="true"


# Data sources (agent tools)

# [FEATURE] Firecrawl scraping, used by product search and product details.
# Get one at https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY="your-firecrawl-api-key"

# [FEATURE] Serper Google search, used by product insight lookups.
# Get one at https://serper.dev/api-key
SERPER_API_KEY="your-serper-api-key"

# [FEATURE] Tavily web search, used by product details and as the web search
# tool for providers without a native one (skipped there when unset).
# Get one at https://app.tavily.com/home
TAVILY_API_KEY="your-tavily-api-key"

# [FEATURE] Marketplace search URL the product search query is appended to.
TOKOPEDIA_SEARCH_BASE_URL="https://www.tokopedia.com/search?q="


# Rate limiting (Upstash Redis)

# [REQUIRED] Upstash Redis REST credentials, used for per-user daily chat rate
# limits. Get them at https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"


# Images (Cloudinary)

# [OPTIONAL] Only used by the /api/blur-data-url route to build image
# placeholders. Find them at https://console.cloudinary.com
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-cloudinary-api-key"
# CLOUDINARY_API_SECRET="your-cloudinary-api-secret"


# Deployment (deploy.sh / docker-compose, read from the shell, not the app)
#
# These tune the build and runtime containers. They can also be passed as
# deploy.sh flags (see `./deploy.sh --help`). Leave unset for the defaults.

# [OPTIONAL] Build mode: host | docker. Default: host
# MODE="host"
# [OPTIONAL] Runtime env file passed to the containers. Default: .env
# ENV_FILE=".env"
# [OPTIONAL] Published host port. Default: 3000
# APP_PORT="3000"
# [OPTIONAL] CPU / memory caps of the running container. Default: none
# APP_CPUS="2"
# APP_MEM="2g"
# [OPTIONAL] Build resource caps. Auto-sized from the host when unset.
# BUILD_CPUS="2"
# BUILD_MEM="4g"
# BUILD_RESERVE_PCT="20"
# NODE_HEAP_MB="4096"
# NEXT_BUILD_CPUS="2"
# [OPTIONAL] Seconds to wait for the health check. Default: 180
# HEALTH_TIMEOUT="180"
# [OPTIONAL] Image tags kept for rollback. Default: 5
# KEEP_IMAGES="5"
# [OPTIONAL] Host mode only: URL used by migrations run on the host when
# DATABASE_URL points at host.docker.internal.
# MIGRATE_DATABASE_URL="postgresql://user:password@localhost:5432/maven"
